# Base URL of the Spring Boot API. Leave empty to use the in-browser mock API.
VITE_API_BASE_URL=
# Set to "false" to disable the mock API and talk to VITE_API_BASE_URL.
VITE_USE_MOCK_API=true
# Simulated network latency range (ms) for the mock API.
VITE_MOCK_LATENCY_MIN=120
VITE_MOCK_LATENCY_MAX=420
